{
  "name": "dsh-shell-prefs",
  "version": "1.0.2",
  "description": "dsh-external in-box dsh bundle: exposes the deployment's locale and theme services to the KCoder desktop shell (account menu reads/switches them through their single upstream write entry), and registers the workspace-name button into the official conversation.session.header.utilities slot (S-D2: injected DOM → official slot).",
  "license": "MIT",
  "type": "module",
  "main": "entry.js",
  "exports": {
    ".": "./entry.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "entry.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/KCoder.git",
    "directory": "bundle/dsh-shell-prefs"
  }
}
