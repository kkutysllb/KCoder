{
  "name": "dsh-language-bundle",
  "version": "1.0.0",
  "description": "dsh-external in-box dsh bundle: the 'force Chinese responses' agent language directive, contributed as a global system-prompt section (toggle is a disabled flip in the DSH_HOME cordis.patch.yml, hot-reloaded).",
  "license": "MIT",
  "type": "module",
  "main": "entry.js",
  "exports": {
    ".": "./entry.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "entry.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "smoke": "node scripts/smoke-plugin.mjs",
    "sync:mirror": "node scripts/sync-to-dsh-plugins.mjs",
    "sync:check": "node scripts/sync-to-dsh-plugins.mjs --check",
    "prepack": "pnpm smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/dsh-language-bundle.git"
  }
}
