{
  "name": "kcoder",
  "productName": "KCoder",
  "description": "KCoder 桌面端：基于 DSH-Desktop 基线的 AI 编码工作台，零修改复用 deepseek-harness 引擎、Web UI 与插件生态",
  "version": "0.6.28",
  "private": true,
  "main": "out/main/index.js",
  "author": "kkutysllb <kkutysllb@users.noreply.github.com>",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "build": "node scripts/dev.mjs build",
    "preview": "node scripts/dev.mjs preview",
    "start": "node scripts/dev.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && node scripts/check-injected-scripts.mjs && node scripts/check-remote-addon-specs.mjs && node scripts/check-shell-protocol.mjs",
    "check": "npm run typecheck && npm run check:bundle-version-line && npm run check:sync-bundles && npm run smoke:bundle-profile",
    "check:bundle-version-line": "node scripts/check-bundle-version-line.mjs",
    "check:sync-bundles": "node scripts/sync-bundles.mjs --check",
    "smoke:bundle-profile": "node scripts/smoke-bundle-profile.mjs",
    "smoke:style-overlay": "node scripts/run-electron.mjs scripts/smoke-style-overlay.mjs",
    "fix:electron": "node scripts/fix-electron.mjs",
    "icons": "electron scripts/make-icons.cjs",
    "setup": "bash scripts/setup.sh",
    "sync-upstream": "bash scripts/sync-upstream.sh",
    "dist": "electron-vite build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "smoke:style-overlay-lifecycle": "node scripts/run-electron.mjs scripts/smoke-style-overlay-lifecycle.mjs",
    "smoke:sidebar-toggle": "node scripts/run-electron.mjs scripts/smoke-sidebar-toggle.mjs",
    "smoke:workspace-header": "node scripts/run-electron.mjs scripts/smoke-workspace-header.mjs",
    "smoke:workspace-probe": "node scripts/run-electron.mjs scripts/smoke-workspace-probe.mjs",
    "smoke:titlebar": "node scripts/run-electron.mjs scripts/smoke-titlebar.mjs",
    "smoke:shell-protocol": "node scripts/run-electron.mjs scripts/smoke-shell-protocol.mjs",
    "smoke:settings-anchors": "node scripts/run-electron.mjs scripts/smoke-settings-anchors.mjs",
    "smoke:account-chip": "node scripts/run-electron.mjs scripts/smoke-account-chip.mjs",
    "smoke:brand-badge": "node scripts/run-electron.mjs scripts/smoke-brand-badge.mjs",
    "smoke:mcp-dom": "node scripts/run-electron.mjs scripts/smoke-mcp-dom.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "semver": "^7.7.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/semver": "^7.5.8",
    "depcheck": "^1.4.7",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "oxlint": "^1.82.0",
    "ts-prune": "^0.10.3",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
