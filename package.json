{
  "name": "kcoder",
  "productName": "KCoder",
  "description": "KCoder 桌面端：基于 DSH-Desktop 基线的 AI 编码工作台，零修改复用 deepseek-harness 引擎、Web UI 与插件生态",
  "version": "0.1.6",
  "private": true,
  "main": "out/main/index.js",
  "author": "kkutysllb <kkutysllb@users.noreply.github.com>",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "electron scripts/make-icons.cjs",
    "setup": "bash scripts/setup.sh",
    "sync-upstream": "bash scripts/sync-upstream.sh",
    "dist": "electron-vite build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "node-pty": "^1.0.0",
    "semver": "^7.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/semver": "^7.5.8",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
