{
  "name": "kcoder",
  "private": true,
  "version": "0.1.0",
  "description": "KCoder — Agent-driven coding desktop app powered by QiLin engine",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @kcoder/app dev",
    "build": "pnpm --filter @kcoder/app build",
    "typecheck": "pnpm -r run typecheck",
    "package": "pnpm --filter @kcoder/app package",
    "rebuild:native": "npx @electron/rebuild -f -w node-pty",
    "postinstall": "npx @electron/rebuild -f -w node-pty"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0"
  }
}
