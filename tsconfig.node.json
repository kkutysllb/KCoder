{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["./desktop/shared/*"]
    }
  },
  "include": ["desktop/main/**/*", "desktop/preload/**/*", "desktop/shared/**/*", "electron.vite.config.ts"]
}
