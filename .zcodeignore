# 上游仓库：仅本地引用，绝不提交（避免污染上游与本项目历史）
deepseek-harness/

# Node
node_modules/
.pnpm-store/

# 构建产物（icon.png 为官方 DeepSeek 图标栅格化产物，随仓库分发）
out/
desktop/out/
dist/
*.dmg
*.zip
*.app

# 打包用的上游运行时物化产物（pnpm deploy，绝不提交）
staging/

# 本地给已安装版本打 asar 热补丁的临时产物（ship 前 git add -A 不应收进）
.tmp-*

# 插件独立仓（真源在仓外）的开发暂存镜像——Write 工具只能写工作区内，
# 改 bundle/ 直提包时先落 <名>-staging/ 再同步到真源仓，不入库
*-staging/
patched-app.asar
app.asar.*.bak

# 日志与缓存
*.log
*.tsbuildinfo
.DS_Store
.idea/
.vscode/
.dsh-vision-router/
.dsh/
.drops/
.patches/discussion-body.md
.patches/
.tmp/

