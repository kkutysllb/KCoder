{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./out",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./renderer/src/*"]
    }
  },
  "include": [
    "main/**/*.ts",
    "preload/**/*.ts",
    "renderer/**/*.ts",
    "renderer/**/*.tsx",
    "electron.vite.config.ts"
  ]
}
