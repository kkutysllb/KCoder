{
  "specVersion": "1.0",
  "id": "systematic-debugging",
  "name": "Systematic Debugging",
  "description": "Use when encountering any bug, test failure, or unexpected behavior, before proposing fixes — evidence-driven diagnosis instead of guesswork.",
  "version": "1.0.0",
  "category": "development",
  "priority": 12,
  "entry": "SKILL.md",
  "activation": {
    "commands": [
      "/systematic-debugging"
    ],
    "promptPatterns": [
      "\\b(systematic debugging|debug.*systematic|系统性.*调试|test failure.*investigate|unexpected behavior)\\b"
    ],
    "fileTypes": [],
    "autoActivate": false
  },
  "commands": [
    {
      "id": "systematic-debugging",
      "alias": [
        "sys-debug"
      ],
      "description": "Systematic evidence-driven debugging",
      "injectPrompt": "Apply the systematic-debugging skill: reproduce the failure, form ranked hypotheses, gather evidence (logs, bisection, minimal repro) before changing any code, then fix the verified root cause."
    }
  ],
  "tools": {
    "allowed": [
      "read",
      "write",
      "bash",
      "grep",
      "find"
    ],
    "declarations": [],
    "mcpServers": {}
  },
  "contributes": {
    "chatMenu": [
      {
        "commandId": "systematic-debugging",
        "title": "Systematic Debugging",
        "icon": "sparkles"
      }
    ],
    "quickTask": []
  },
  "permissions": {
    "workspace": "write",
    "network": false,
    "exec": "workspace",
    "requiresApproval": "on-request"
  },
  "assets": []
}
