    "chatMenu": [
      {
        "commandId": "subagent-driven-development",
        "title": "Sub-agent Driven Development",
        "icon": "sparkles"
      }
    ],
    "quickTask": []
  },
  "permissions": {
    "workspace": "write",
    "network": false,
    "exec": "workspace",
    "requiresApproval": "on-request"
  },
  "assets": []
}
