  "category": "workflow",
  "priority": 8,
  "entry": "SKILL.md",
  "activation": {
    "commands": [
      "/subagent-driven-development"
    ],
    "promptPatterns": [
      "\\b(sub-?agent (driven|development)|dispatch.*tasks?|子代理.*执行|parallel implementation)\\b"
    ],
    "fileTypes": [],
    "autoActivate": false
  },
  "commands": [
    {
      "id": "subagent-driven-development",
      "alias": [
