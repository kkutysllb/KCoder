    "chatMenu": [
      {
        "commandId": "mcp-builder",
        "title": "Build MCP server",
        "icon": "plug"
      }
    ],
    "quickTask": []
  },
  "permissions": {
    "workspace": "write",
    "network": true,
    "exec": "workspace",
    "requiresApproval": "on-request"
  },
  "assets": []
}
