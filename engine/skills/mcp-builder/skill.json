  "category": "development",
  "priority": 3,
  "entry": "SKILL.md",
  "activation": {
    "commands": [
      "/mcp-builder"
    ],
    "promptPatterns": [
      "\\b(mcp.*server|mcp.*构建|build.*mcp|model context protocol)\\b"
    ],
    "fileTypes": [],
    "autoActivate": false
  },
  "commands": [
    {
      "id": "mcp-builder",
      "alias": [
