{
  "specVersion": "1.0",
  "id": "requesting-code-review",
  "name": "Requesting Code Review",
  "description": "Use when completing tasks, implementing major features, or before merging — prepare work for review with a self-check checklist, context summary, and defined review scope.",
  "version": "1.0.0",
  "category": "review",
  "priority": 7,
  "entry": "SKILL.md",
  "activation": {
    "commands": [
      "/requesting-code-review"
    ],
    "promptPatterns": [
      "\\b(request(ing)? (a )?code review|submit.*for review|提交.*评审|review my (code|changes|pr))\\b"
    ],
    "fileTypes": [],
    "autoActivate": false
  },
  "commands": [
    {
      "id": "requesting-code-review",
      "alias": [
        "ask-review"
      ],
      "description": "Prepare work for code review",
      "injectPrompt": "Apply the requesting-code-review skill: self-review the changes against a checklist, write a context summary (what/why/how/risk), define the review scope, and submit with tests passing."
    }
  ],
  "tools": {
    "allowed": [
      "read",
      "write",
      "bash",
      "grep",
      "find"
    ],
    "declarations": [],
    "mcpServers": {}
  },
  "contributes": {
    "chatMenu": [
      {
        "commandId": "requesting-code-review",
        "title": "Requesting Code Review",
        "icon": "sparkles"
      }
    ],
    "quickTask": []
  },
  "permissions": {
    "workspace": "write",
    "network": true,
    "exec": "workspace",
    "requiresApproval": "on-request"
  },
  "assets": []
}
