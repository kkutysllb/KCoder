{
  "specVersion": "1.0",
  "id": "receiving-code-review",
  "name": "Receiving Code Review",
  "description": "Use when receiving code review feedback, before implementing suggestions — requires technical rigor and verification, not performative agreement or blind implementation.",
  "version": "1.0.0",
  "category": "review",
  "priority": 7,
  "entry": "SKILL.md",
  "activation": {
    "commands": [
      "/receiving-code-review"
    ],
    "promptPatterns": [
      "\\b(receiving.*review|review feedback|处理.*评审|respond to.*review|address.*comments)\\b"
    ],
    "fileTypes": [],
    "autoActivate": false
  },
  "commands": [
    {
      "id": "receiving-code-review",
      "alias": [
        "handle-review"
      ],
      "description": "Handle code review feedback rigorously",
      "injectPrompt": "Apply the receiving-code-review skill: evaluate each piece of review feedback technically — verify claims against the code, test suggestions before implementing, and push back with evidence when feedback is incorrect."
    }
  ],
  "tools": {
    "allowed": [
      "read",
      "write",
      "bash",
      "grep",
      "find"
    ],
    "declarations": [],
    "mcpServers": {}
  },
  "contributes": {
    "chatMenu": [
      {
        "commandId": "receiving-code-review",
        "title": "Receiving Code Review",
        "icon": "sparkles"
      }
    ],
    "quickTask": []
  },
  "permissions": {
    "workspace": "write",
    "network": false,
    "exec": "workspace",
    "requiresApproval": "on-request"
  },
  "assets": []
}
