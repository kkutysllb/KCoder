{
  "specVersion": "1.0",
  "id": "docx",
  "name": "Word Document",
  "description": "Create, read, edit, and manipulate Word documents (.docx) including formatting, tables, images, and tracked changes.",
  "version": "1.0.0",
  "category": "workflow",
  "priority": 5,
  "entry": "SKILL.md",
  "activation": {
    "commands": [
      "/docx"
    ],
    "promptPatterns": [
