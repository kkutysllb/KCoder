      ],
      "description": "Create or edit Word documents",
      "injectPrompt": "Apply the docx skill: use python-docx to create, read, or edit Word documents with proper headings, styles, tables, page numbers, and formatting. Verify the output file structure is valid."
    }
  ],
  "tools": {
    "allowed": [
      "read",
      "write",
      "bash",
      "grep",
      "find"
    ],
    "declarations": [],
    "mcpServers": {}
  },
  "contributes": {
    "chatMenu": [
      {
        "commandId": "docx",
        "title": "Word document",
        "icon": "file-text"
      }
    ],
    "quickTask": []
  },
  "permissions": {
    "workspace": "write",
    "network": false,
    "exec": "workspace",
    "requiresApproval": "on-request"
  },
  "assets": []
}
