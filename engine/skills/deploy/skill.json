{
  "specVersion": "1.0",
  "id": "deploy",
  "name": "Deploy",
  "description": "Deploy applications to cloud platforms (Vercel, Netlify, Docker, static hosting) with automated setup and verification.",
  "version": "1.0.0",
  "category": "integration",
  "priority": 5,
  "entry": "SKILL.md",
  "activation": {
    "commands": [
      "/deploy"
    ],
    "promptPatterns": [
      "\\b(deploy|部署|上线|push.*live|发布.*应用)\\b"
    ],
    "fileTypes": [],
    "autoActivate": false
  },
  "commands": [
    {
      "id": "deploy",
      "alias": [
        "部署"
      ],
      "description": "Deploy the application",
      "injectPrompt": "Apply the deploy skill: detect the project type, choose the appropriate deployment target, run build verification, deploy, and confirm the deployment is live with a working URL."
    }
  ],
  "tools": {
    "allowed": [
      "read",
      "write",
      "bash",
      "grep",
      "find",
      "web_fetch"
    ],
    "declarations": [],
    "mcpServers": {}
  },
  "contributes": {
    "chatMenu": [
      {
        "commandId": "deploy",
        "title": "Deploy app",
        "icon": "rocket"
      }
    ],
    "quickTask": []
  },
  "permissions": {
    "workspace": "write",
    "network": true,
    "exec": "workspace",
    "requiresApproval": "on-request"
  },
  "assets": []
}
