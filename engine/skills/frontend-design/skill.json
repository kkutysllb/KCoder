      "injectPrompt": "Apply the frontend-design skill: create polished, distinctive UI following the project's existing design system. Prioritize visual hierarchy, spacing rhythm, micro-interactions, and responsive behavior. Avoid generic template aesthetics."
    }
  ],
  "tools": {
    "allowed": [
      "read",
