    "declarations": [],
    "mcpServers": {}
  },
  "contributes": {
    "chatMenu": [
      {
        "commandId": "frontend-design",
        "title": "Frontend design",
        "icon": "palette"
      }
    ],
    "quickTask": []
  },
  "permissions": {
    "workspace": "write",
    "network": false,
    "exec": "workspace",
    "requiresApproval": "on-request"
  },
  "assets": []
}
