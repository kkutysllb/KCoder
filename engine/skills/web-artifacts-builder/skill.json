{
  "specVersion": "1.0",
  "id": "web-artifacts-builder",
  "name": "Web Artifacts Builder",
  "description": "Suite for creating elaborate, multi-component web artifacts with React, Tailwind CSS, and shadcn/ui — for complex artifacts requiring state management, routing, or shadcn/ui components.",
  "version": "1.0.0",
  "category": "development",
  "priority": 6,
  "entry": "SKILL.md",
  "activation": {
    "commands": [
      "/web-artifacts"
    ],
    "promptPatterns": [
      "\\b(web artifact|复杂.*组件.*应用|shadcn.*artifact|multi-?component artifact|interactive app.*artifact)\\b"
    ],
    "fileTypes": [],
    "autoActivate": false
  },
  "commands": [
    {
      "id": "web-artifacts",
      "alias": [
        "artifact-builder"
      ],
      "description": "Build multi-component web artifacts",
      "injectPrompt": "Apply the web-artifacts-builder skill: build the artifact as a structured React app with Tailwind + shadcn/ui — component decomposition, state management, and routing where the complexity demands it."
    }
  ],
  "tools": {
    "allowed": [
      "read",
      "write",
      "bash",
      "grep",
      "find"
    ],
    "declarations": [],
    "mcpServers": {}
  },
  "contributes": {
    "chatMenu": [
      {
        "commandId": "web-artifacts",
        "title": "Web Artifacts Builder",
        "icon": "sparkles"
      }
    ],
    "quickTask": []
  },
  "permissions": {
    "workspace": "write",
    "network": true,
    "exec": "workspace",
    "requiresApproval": "on-request"
  },
  "assets": []
}
