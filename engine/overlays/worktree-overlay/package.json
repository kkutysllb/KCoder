{
  "name": "@kcoder/worktree-overlay",
  "version": "0.1.0",
  "description": "KCoder overlay: per-branch git worktree isolation for parallel agent workflows. A 'pudding' package that strengthens the QiongQi engine without modifying its source.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "kcoder-worktree-mcp": "./dist/mcp-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/mcp-server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.2"
  },
  "private": true,
  "types": "./dist/index.d.ts"
}
