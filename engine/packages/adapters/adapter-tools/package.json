{
  "name": "@qiongqi/adapter-tools",
  "version": "1.1.2",
  "description": "Qiongqi adapter-tools package",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@qiongqi/adapter-fs": "workspace:*",
    "@qiongqi/contracts": "workspace:*",
    "@qiongqi/delegation": "workspace:*",
    "@qiongqi/domain": "workspace:*",
    "@qiongqi/memory": "workspace:*",
    "@qiongqi/ports": "workspace:*",
    "@qiongqi/services": "workspace:*",
    "@qiongqi/tool-infra": "workspace:*",
    "diff": "^8.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.8.2"
  },
  "private": true,
  "types": "./dist/index.d.ts"
}
