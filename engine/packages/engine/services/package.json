{
  "name": "@qiongqi/services",
  "version": "1.1.4",
  "description": "Qiongqi services package",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qiongqi/cache": "workspace:*",
    "@qiongqi/contracts": "workspace:*",
    "@qiongqi/domain": "workspace:*",
    "@qiongqi/ports": "workspace:*",
    "@qiongqi/tool-infra": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.8.2"
  },
  "private": true,
  "types": "./dist/index.d.ts"
}
