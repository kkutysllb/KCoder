{
  "serve": {
    "host": "127.0.0.1",
    "port": 8899,
    "dataDir": "~/.qiongqi/data",
    "runtimeToken": "",
    "approvalPolicy": "auto",
    "sandboxMode": "workspace-write",
    "tokenEconomyMode": true,
    "tokenEconomy": {
      "enabled": true,
      "compressToolDescriptions": true,
      "compressToolResults": true,
      "conciseResponses": true,
      "historyHygiene": {
        "maxToolResultLines": 320,
        "maxToolResultBytes": 32768,
        "maxToolResultTokens": 8000,
        "maxToolArgumentStringBytes": 8192,
        "maxToolArgumentStringTokens": 2000,
        "maxArrayItems": 80
      }
    },
    "insecure": false,
    "storage": {
      "backend": "hybrid"
    },
    "observability": {
      "openTelemetry": {
        "enabled": false,
        "serviceName": "qiongqi-engine",
        "exporter": "otlp-http",
        "endpoint": "http://127.0.0.1:4318/v1/traces",
        "headers": {}
      }
    }
  },
  "models": {
    "profiles": {
      "primary": {
        "providerModel": "provider-model-primary",
        "baseUrl": "https://provider.example/v1",
        "endpointFormat": "responses",
        "contextWindowTokens": 128000,
        "contextCompaction": {
          "softThreshold": 96000,
          "hardThreshold": 112000
        },
        "inputModalities": ["text"],
        "outputModalities": ["text"],
        "supportsToolCalling": true,
        "messageParts": ["text"]
      },
      "fast": {
        "providerModel": "provider-model-fast",
        "baseUrl": "https://another-provider.example/v1",
        "endpointFormat": "messages",
        "contextWindowTokens": 64000,
        "contextCompaction": {
          "softThreshold": 48000,
          "hardThreshold": 56000
        },
        "inputModalities": ["text"],
        "outputModalities": ["text"],
        "supportsToolCalling": true,
        "messageParts": ["text"]
      }
    }
  },
  "contextCompaction": {
    "defaultSoftThreshold": 64000,
    "defaultHardThreshold": 96000,
    "summaryMode": "model",
    "summaryTimeoutMs": 15000,
    "summaryMaxTokens": 1200,
    "summaryInputMaxBytes": 98304
  },
  "runtime": {
    "orchestrationMode": "evented_v2",
    "eventedV2OutboxReconciler": {
      "enabled": true,
      "intervalMs": 1000
    },
    "eventedV2AgentGraph": {
      "version": 1,
      "graphId": "durable_agent_graph",
      "startNodeId": "planner",
      "nodes": [
        { "id": "planner", "kind": "agent", "agentId": "planner", "label": "Planner" },
        { "id": "wait_approval", "kind": "wait", "waitFor": "approval" }
      ],
      "edges": [
        { "from": "planner", "to": "wait_approval", "condition": "completed" }
      ]
    },
    "eventedV2AgentPeers": {},
    "eventedV2RemoteAgent": {
      "timeoutMs": 30000,
      "leaseTtlMs": 60000,
      "heartbeatTtlMs": 180000,
      "scheduler": {
        "enabled": true,
        "intervalMs": 1000
      },
      "compensation": {
        "statusConditions": {
          "failed": "failed",
          "aborted": "aborted"
        }
      }
    }
  },
  "capabilities": {
    "mcp": {
      "enabled": false,
      "search": {
        "enabled": false,
        "mode": "auto",
        "autoThresholdToolCount": 24,
        "topKDefault": 5,
        "topKMax": 10,
        "minScore": 0.15,
        "bm25": { "k1": 1.2, "b": 0.75 }
      },
      "servers": {}
    },
    "web": {
      "enabled": false,
      "fetchEnabled": false,
      "searchEnabled": false,
      "allowDomains": [],
      "denyDomains": []
    },
    "skills": {
      "enabled": false,
      "roots": [],
      "legacySkillMd": false
    },
    "subagents": {
      "enabled": false,
      "maxParallel": 0,
      "maxChildRuns": 0
    },
    "attachments": {
      "enabled": false,
      "maxImageBytes": 5242880,
      "maxImageDimension": 4096,
      "allowedMimeTypes": ["image/png", "image/jpeg", "image/webp"],
      "textFallbackMaxBase64Bytes": 524288,
      "textFallbackMaxImageDimension": 1280,
      "textFallbackPreferredMimeType": "image/webp"
    },
    "memory": {
      "enabled": false,
      "scopes": ["user", "workspace", "project"],
      "maxInjectedRecords": 8
    }
  }
}
