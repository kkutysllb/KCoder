-  '@earendil-works/pi-ai@0.84.3(patch_hash=a1a6fdfe88856c21018a6a646b3494167d4187402752e15ace3155fee805e4bf)(@modelcontextprotocol/sdk@1.29.0(zod@4.4.3))(ws@8.21.3)(zod@4.4.3)':
+  '@earendil-works/pi-ai@0.84.3(patch_hash=4e4bd7a9145339e274cce53c46d9234db1d793c346efe6a7514341522c0f8f63)(@modelcontextprotocol/sdk@1.29.0(zod@4.4.3))(ws@8.21.3)(zod@4.4.3)':
