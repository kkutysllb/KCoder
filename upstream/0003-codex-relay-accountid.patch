 patches/@earendil-works__pi-ai@0.84.3.patch | 20 ++++++++++++++++++++
 pnpm-lock.yaml                              |  5 +++--
 pnpm-workspace.yaml                         |  1 +
 4 files changed, 25 insertions(+), 2 deletions(-)
 create mode 100644 patches/@earendil-works__pi-ai@0.84.3.patch

