       kind: 'aborted',
       failure: { message: message.errorMessage ?? 'pi-ai stream aborted', code: 'ABORTED' },
     }
+    case 'pending':
+    case 'deferred': {
+      // Non-terminal pi-ai reasons (deferred-tools scheduling and pending
+      // continuations). The harness withholds those features, so reaching a
+      // terminal mapping with them is unexpected: surface as error and let
+      // the retry policy decide.
+      const text = message.errorMessage ?? `model "${message.model}" ended with unexpected stop reason "${message.stopReason}"`
+      return { kind: 'error', failure: { message: text, code: classifyPiAiError(text) } }
+    }
     case 'error': {
       const text = message.errorMessage ?? 'pi-ai stream error'
+      // pi-ai 0.84 delivers caller aborts through the error event channel
+      // (`stopReason: 'error'`, message "Request aborted") instead of the
+      // `aborted` stop reason; restore the harness vocabulary here.
+      if (/\baborted?\b/i.test(text)) {
+        return { kind: 'aborted', failure: { message: text, code: 'ABORTED' } }
+      }
       return { kind: 'error', failure: { message: text, code: classifyPiAiError(text) } }
     }
   }
