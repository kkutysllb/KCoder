# KCoder QiLin sidecar 运行时配置 — 模板
#
# 复制本文件为 config.yaml 并填入真实值：
#     cp config.yaml.example config.yaml
#
# ⚠️ config.yaml 包含敏感信息（API key），已在 .gitignore 中忽略，切勿提交。
#
# 运行机制：
#   KCoder 的 model store（Settings > 模型配置）在保存/激活/删除模型时，
#   会通过 qilin-config-injector.ts 自动把 user-data.json 里的 profile 写入
#   config.yaml 的 models: 段（段落保留式替换，不影响 sandbox 等其它段）。
#   QiLin 引擎通过文件 signature 检测自动热重载，无需重启。
#   因此本文件运行时会自动更新，手动编辑的内容会被覆盖。
#
# 字段说明：
#   sandbox.use       必填。'local' = 进程内文件系统（coding 场景）
#   models[].name     模型唯一标识（注入时用 profile id）
#   models[].use      module:Class 格式（resolve_class 要求）
#                     openai     -> langchain_openai:ChatOpenAI
#                     anthropic  -> langchain_anthropic:ChatAnthropic
#                     minimax    -> qilin.models.patched_minimax:PatchedChatMiniMax
#                     ollama     -> langchain_ollama:ChatOllama
#   models[].model    provider 的模型名（如 gpt-4o-mini）
#   models[].api_key  真实 API key（运行时由 KCoder Settings 注入）
#   models[].openai_api_base  自定义 API 基址（兼容 OpenAI 协议的供应商）
#   models[].supports_thinking / supports_vision / supports_reasoning_effort
#                     能力位（布尔），控制 UI 与推理行为

sandbox:
  use: local
  allow_host_bash: true  # 启用 host bash 工具（否则被 is_host_bash_allowed 过滤）

models:
  # 占位模型——避免引擎启动时 models 为空而报错（fallback 路径会取 models[0]）。
  # KCoder Settings 保存首个模型 profile 后，此占位会被自动替换为真实配置。
  - name: kcoder-default
    display_name: KCoder Default
    description: Placeholder model; real API key injected by KCoder Settings at runtime
    use: langchain_openai:ChatOpenAI
    model: gpt-4o-mini
    api_key: placeholder-injected-by-kcoder-settings
    openai_api_base: https://api.openai.com/v1

# ─── 工具集 ───
# 权威定义见 vendor/qilin/config.example.yaml（tools 段）
# bash 工具需配合 sandbox.allow_host_bash: true，否则被 is_host_bash_allowed 过滤
tools:
  - name: ls
    group: file:read
    use: qilin.sandbox.tools:ls_tool
  - name: read_file
    group: file:read
    use: qilin.sandbox.tools:read_file_tool
  - name: glob
    group: file:read
    use: qilin.sandbox.tools:glob_tool
    max_results: 200
  - name: grep
    group: file:read
    use: qilin.sandbox.tools:grep_tool
    max_results: 100
  - name: write_file
    group: file:write
    use: qilin.sandbox.tools:write_file_tool
  - name: str_replace
    group: file:write
    use: qilin.sandbox.tools:str_replace_tool
  - name: bash
    group: bash
    use: qilin.sandbox.tools:bash_tool
  - name: run_tests
    group: bash
    use: qilin.sandbox.tools:run_tests_tool
  - name: web_search
    group: web
    use: qilin.community.ddg_search.tools:web_search_tool
    max_results: 5
  # ── 浏览器自动化（有状态 Playwright Chromium） ──
  # 有状态浏览器工具：browser_navigate → browser_click/type → browser_snapshot 循环。
  # 启动参数从 network 配置段读取 fallback；per-tool config 可覆盖。
  # 需要安装可选依赖：cd python-runtime && uv sync --extra browser && uv run playwright install chromium
  - name: browser_navigate
    group: browser
    use: qilin.community.browser_automation.tools:browser_navigate_tool
  - name: browser_snapshot
    group: browser
    use: qilin.community.browser_automation.tools:browser_snapshot_tool
  - name: browser_click
    group: browser
    use: qilin.community.browser_automation.tools:browser_click_tool
  - name: browser_type
    group: browser
    use: qilin.community.browser_automation.tools:browser_type_tool
  - name: browser_get_text
    group: browser
    use: qilin.community.browser_automation.tools:browser_get_text_tool
    max_chars: 8000
  - name: browser_back
    group: browser
    use: qilin.community.browser_automation.tools:browser_back_tool
  - name: browser_screenshot
    group: browser
    use: qilin.community.browser_automation.tools:browser_screenshot_tool
  - name: browser_close
    group: browser
    use: qilin.community.browser_automation.tools:browser_close_tool

# ─── 技能 ───
# path 相对 cwd（langgraph dev 在 python-runtime/ 下运行），指向项目根 skills 目录。
# 结构：<path>/public/<name>/SKILL.md（SkillCategory.PUBLIC = "public"）
# 内置 coding 技能包（复制自 KSkills/coding，作为公共内置技能）
skills:
  path: ../skills
  scan:
    enabled: true

# ─── 记忆 ───
# ─── 记忆 ───
# 产品级决策：KCoder 默认关闭 QiLin 的用户级跨线程记忆。
# thread 是项目作用域任务，而 memory 是用户级（跨线程共享）：注入会让新线程
# 携带旧任务的项目总结，模型误当"本会话早期"上下文 → 新任务答非所问。
# 后端 manager_class=qilinmem 已验证可用（create/get/delete 全通）。
# Settings > Memory 面板的 CRUD 走 gateway memory_routes.py → QiLin MemoryManager。
memory:
  enabled: false
  mode: middleware
  injection_enabled: false
  manager_class: qilinmem

# ─── 网络与 Web 工具 ───
# 全局代理与 web 工具默认值。Settings > Web 工具面板的读写走 gateway
# runtime_config_routes.py → config.yaml network 段（热重载）。
# proxy 为空/null 时直连；所有 web 工具（web_search / web_fetch /
# image_search / 浏览器自动化）共享同一个 proxy。
network:
  proxy: null                    # 全局代理，如 http://127.0.0.1:7890 或 socks5://127.0.0.1:7891
  web_search_max_results: 5      # web_search 返回的最大结果数（1-50）
  web_fetch_timeout: 10          # web_fetch 每次请求超时秒数（1-120）
  image_search_max_results: 5    # image_search 返回的最大结果数（1-50）
  # Playwright Chromium 浏览器自动化参数（browser_navigate 等）
  browser_headless: true         # 无头模式，不显示浏览器窗口
  browser_viewport_width: 1280   # 视口宽度像素（320-3840）
  browser_viewport_height: 720   # 视口高度像素（240-2160）
  browser_timeout_ms: 30000      # 导航/交互操作超时毫秒（1000-120000）

# 开发阶段用 sqlite（默认）；生产可切 postgres（AppConfig.database.backend）
