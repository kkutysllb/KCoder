# KCoder QiLin sidecar 环境变量
# langgraph.json 的 "env" 字段会加载这个文件
#
# 指向同目录的 config.yaml（QiLin AppConfig）
QILIN_CONFIG_PATH=./config.yaml

# 指向同目录的 extensions_config.json（QiLin MCP servers + skills）
# gateway 的 main.py 会在启动时动态生成此文件（注册 worktree-overlay）
QILIN_EXTENSIONS_CONFIG_PATH=./extensions_config.json

# LangGraph Platform 内部端口（langgraph dev 监听）
# runtime-manager.ts 会通过 --port 覆盖
PORT=19200

# 关闭 LangGraph 自动开浏览器
BROWSER=false
